# 念念 Eterna - Environment Configuration
# Copy this file to .env.local and fill in your values

# AI / LLM (required for text generation)
# DeepSeek OpenAI-compatible example:
MIMO_API_KEY=
MIMO_API_BASE=https://api.deepseek.com/v1
# Backward-compatible alias used by older local configs
MIMO_BASE_URL=https://api.deepseek.com/v1
MIMO_CHAT_MODEL=deepseek-v4-pro
MIMO_OMNI_MODEL=deepseek-v4-pro
MIMO_TTS_MODEL=mimo-v2-tts
MIMO_VIDEO_MODEL=deepseek-v4-pro
MIMO_TTS_VOICE=default_zh
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2

# ComfyUI (required for memorial video visuals)
COMFYUI_API_BASE=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=DreamShaper_8_pruned.safetensors
COMFYUI_STEPS=12
COMFYUI_CFG=6.5
COMFYUI_DENOISE=0.42
COMFYUI_IMAGE_WIDTH=1024
COMFYUI_IMAGE_HEIGHT=576

# Data / Admin
DATA_DIR=/var/lib/eterna-niannian
ADMIN_EMAILS=

# Stripe Billing (required for subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEED=
STRIPE_PRICE_TREE=
STRIPE_PRICE_GARDEN=
STRIPE_PRICE_FAMILY=

# Phone bridge / outbound calls (optional)
OUTBOUND_CALL_WEBHOOK_URL=
OUTBOUND_CALL_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_BASE_URL=http://localhost:8102
PHONE_CALL_MAX_TURNS=3
DEFAULT_TIMEZONE=Asia/Shanghai
PROACTIVE_POLL_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8102
ALLOWED_ORIGINS=https://eterna-niannian.cloud
PUBLIC_BASE_URL=https://eterna-niannian.cloud
APP_BASE_URL=https://eterna-niannian.cloud

# WeChat Mini Program (scaffold-ready)
MINIPROGRAM_APP_NAME=念念 Eterna
MINIPROGRAM_APP_ID=
MINIPROGRAM_API_BASE=https://eterna-niannian.cloud
MINIPROGRAM_DEFAULT_LOCALE=zh-CN
MINIPROGRAM_STATUS=scaffold_ready
MINIPROGRAM_UPLOAD_MAX_MB=200

# FFmpeg (for video processing)
# FFMPEG_BIN=/usr/local/bin/ffmpeg
