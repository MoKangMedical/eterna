page {
  background: #f5ede2;
  color: #4a3627;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card,
.memory-card,
.chat-card,
.profile-card {
  background: rgba(255, 250, 244, 0.96);
  border: 1rpx solid rgba(160, 127, 95, 0.15);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(97, 64, 33, 0.08);
}

.hero-card {
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
}

.section-card,
.profile-card,
.chat-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5b3e29;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8b755f;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5b3e29;
}

.section-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a856f;
}

.warm-button {
  background: linear-gradient(135deg, #b57e52, #8e5f3d);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ghost-button {
  background: #fff6ec;
  color: #7a573d;
  border: 1rpx solid rgba(140, 97, 63, 0.18);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.input-field,
.text-area,
.picker-shell {
  background: #fffdf9;
  border-radius: 22rpx;
  border: 1rpx solid rgba(160, 127, 95, 0.16);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #4f3827;
  box-sizing: border-box;
}

.text-area {
  width: 100%;
  min-height: 180rpx;
}

.picker-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.soft-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f6ebdd;
  color: #7d6047;
  font-size: 22rpx;
}

.muted-text {
  font-size: 24rpx;
  color: #9b856f;
}

.empty-state {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #9a856f;
  font-size: 26rpx;
}
