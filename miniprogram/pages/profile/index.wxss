.profile-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  font-size: 27rpx;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.profile-metric {
  background: #fff8ef;
  border-radius: 20rpx;
  padding: 22rpx;
}
